<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <SteamworksDir>$(LOCALAPPDATA)\PlutonTools\downloads\steamworksnet\extracted\Windows-x64</SteamworksDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Steamworks.NET">
      <HintPath>$(SteamworksDir)\Steamworks.NET.dll</HintPath>
    </Reference>
    <None Include="$(SteamworksDir)\steam_api64.dll" CopyToOutputDirectory="PreserveNewest" Link="steam_api64.dll" />
  </ItemGroup>
</Project>
