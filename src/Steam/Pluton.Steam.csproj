<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pluton.Steam</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <SteamworksDir>$(LOCALAPPDATA)\PlutonTools\downloads\steamworksnet\extracted\Windows-x64</SteamworksDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Steamworks.NET">
      <HintPath>$(SteamworksDir)\Steamworks.NET.dll</HintPath>
    </Reference>
    <ProjectReference Include="..\Networking\Pluton.Networking.csproj" />
  </ItemGroup>
</Project>
